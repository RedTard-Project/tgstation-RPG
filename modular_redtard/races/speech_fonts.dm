// Speech fonts of the races' languages, as on Ratwood: a language puts its span on what is said in it (TG adds a
// language's spans to its speech, /mob/living/say()), and the chat panel draws that span in the language's own face
// (tgui/rogue_panel/chat/speech_fonts.scss). The class names are Ratwood's for its languages and Vibelin's for the ones
// Ratwood has not; Halfspeak shares the dwarven face, as on Vibelin. The languages themselves are generated by the
// porters (rockhill/ported/races.dm, heritage/ported/races.dm), so their spans are set here.

// Ratwood's languages.
/datum/language/rogue_elvish
	spans = list("elf")

/datum/language/rogue_orcish
	spans = list("orc")

// TG's Draconic is Ratwood's too (the same type there), in its reptile face. The chat panel is the same on every map,
// so the lizards of the modern maps speak in it as well.
/datum/language/draconic
	spans = list("reptile")

// Vibelin's languages: Ratwood's face where Ratwood speaks the same tongue.
/datum/language/rogue_dwarvish
	spans = list("dwarf")

/datum/language/rogue_halfling
	spans = list("dwarf")

/datum/language/rogue_infernal
	spans = list("hellspeak")

/datum/language/rogue_beast
	spans = list("beast")

/datum/language/rogue_celestial
	spans = list("celestial")

/datum/language/rogue_zalad
	spans = list("zalad")

/datum/language/rogue_deepspeak
	spans = list("deepspeak")

/datum/language/rogue_kobold
	spans = list("kobold")
