/// Ratwood anvil recipe (roguejobs/blacksmith/anvil_recipes/_anvil_recipe.dm). The recipes themselves are generated by the
/// porter into crafting/ported/anvil_recipes.dm under Ratwood's own paths; a recipe without a created_item is a parent.
/datum/anvil_recipe
	var/name
	/// Ratwood i_type: the tab of the anvil window.
	var/category = "Misc"
	/// Ratwood display_category: the group inside the tab.
	var/display_category
	/// The bar the work starts from.
	var/obj/item/req_bar
	/// A cast blade the work can start from instead (Ratwood req_blade): it replaces the bar and one bar of the materials,
	/// needs no heat and is finished on the anvil without quenching (casting.dm).
	var/obj/item/req_blade
	var/obj/item/created_item
	var/createditem_num = 1
	/// Materials added on the anvil after each finished stage, in any order.
	var/list/additional_items = list()
	/// Ratwood rank the recipe is meant for; below it a strike rarely lands.
	var/craftdiff = ROGUE_RANK_NONE
	var/appro_skill = /datum/attribute/skill/craft/blacksmithing
	var/max_progress = 100
	/// Cached anvil window entry.
	var/list/ui_entry

GLOBAL_LIST_INIT(rogue_anvil_recipes, init_rogue_anvil_recipes())

/proc/init_rogue_anvil_recipes()
	. = list()
	for(var/datum/anvil_recipe/recipe_type as anything in subtypesof(/datum/anvil_recipe))
		if(!initial(recipe_type.name) || !initial(recipe_type.created_item))
			continue
		if(!initial(recipe_type.req_bar) && !initial(recipe_type.req_blade))
			continue
		. += new recipe_type

/// The work on the anvil can follow this recipe: the recipe's bar or its cast blade (Ratwood anvil ui_act()).
/datum/anvil_recipe/proc/accepts(obj/item/work)
	if(!work)
		return FALSE
	return (req_bar && istype(work, req_bar)) || (req_blade && istype(work, req_blade))

/datum/anvil_recipe/proc/get_ui_entry()
	if(ui_entry)
		return ui_entry
	var/list/materials = list()
	for(var/obj/item/material as anything in additional_items)
		materials[initial(material.name)] += 1
	var/list/extra = list()
	for(var/material_name in materials)
		extra += materials[material_name] > 1 ? "[materials[material_name]] [material_name]" : material_name
	var/datum/attribute/skill/skill = GET_ROGUE_ATTRIBUTE(appro_skill)
	ui_entry = list(
		"ref" = REF(src),
		"name" = name,
		"category" = category,
		"group" = display_category || category,
		"icon" = sanitize_css_class_name("[created_item]"),
		"bar" = req_bar ? initial(req_bar.name) : null,
		"blade" = req_blade ? initial(req_blade.name) : null,
		"materials" = extra,
		"count" = createditem_num,
		"skill" = skill?.name,
		"difficulty" = craftdiff ? skill?.description_from_level(craftdiff * ROGUE_SKILL_PER_RANK) : "any",
		"desc" = initial(created_item.desc),
	)
	return ui_entry

// Numbers of config/redtard/mechanics/values.txt (section "Crafting").
#define FORGING_HEALTH_PER_QUALITY rogue_value("forging_health_per_quality")
/// Ratwood advance_recipe(): a good strike on a cast blade starts from more progress than 1.
#define FORGING_BLADE_BREAKTHROUGH rogue_value("forging_blade_breakthrough")

/// Ratwood /datum/component/forging (roguejobs/blacksmith/smith_components.dm) on the bar being worked: progress,
/// bar health, accumulated skill and material quality; finished work is quenched into the recipe's goods.
/datum/component/rogue_forging
	dupe_mode = COMPONENT_DUPE_UNIQUE
	var/datum/anvil_recipe/recipe
	var/stage = ROGUE_FORGING_ACTIVE
	var/progress = 0
	var/skill_quality = 0
	var/material_quality = 0
	var/bar_health = 100
	var/hits = 0
	var/breakthroughs = 0
	/// Materials worked in so far, the bar included (Ratwood num_of_materials).
	var/materials = 1
	/// Material the next stage waits for (Ratwood needed_item).
	var/obj/item/needed_item
	/// Materials still to come (Ratwood's copy of additional_items).
	var/list/remaining
	/// Quality of the last bar added, given to non-bar materials (Ratwood previous_material_quality).
	var/last_quality = ROGUE_QUALITY_STANDARD
	/// The work started from a cast blade (Ratwood using_blade): one bar fewer and no quench.
	var/from_blade = FALSE

/datum/component/rogue_forging/Initialize(datum/anvil_recipe/chosen)
	if(!isitem(parent) || !istype(chosen))
		return COMPONENT_INCOMPATIBLE
	recipe = chosen
	remaining = chosen.additional_items.Copy()
	// Ratwood set_recipe(): a cast blade already holds the metal of one of the bars the recipe adds.
	if(istype(parent, /obj/item/blade))
		from_blade = TRUE
		for(var/material in remaining)
			if(ispath(material, /obj/item/ingot))
				remaining -= material
				break
	var/obj/item/bar = parent
	last_quality = bar.rogue_material_quality()
	material_quality = last_quality
	bar_health = FORGING_HEALTH_PER_QUALITY * (last_quality + 1)

/datum/component/rogue_forging/Destroy(force)
	recipe = null
	return ..()

/// Ratwood anvil attackby() with a material: the stage's material goes in, its quality counts toward the goods.
/datum/component/rogue_forging/proc/add_material(obj/item/added, mob/living/user)
	if(!needed_item || !istype(added, needed_item))
		return FALSE
	if(istype(added, /obj/item/ingot))
		last_quality = added.rogue_material_quality()
	material_quality += last_quality
	materials++
	needed_item = null
	progress = 0
	to_chat(user, span_notice("You add \the [added] to \the [parent]."))
	qdel(added)
	return TRUE

/// One hammer strike (Ratwood on_hammered_on_anvil() and advance_recipe()); returns TRUE if the work is done.
/datum/component/rogue_forging/proc/strike(mob/living/user, breakthrough)
	if(stage != ROGUE_FORGING_ACTIVE)
		return FALSE
	if(progress >= recipe.max_progress && !needed_item)
		to_chat(user, span_info("It's ready."))
		return TRUE
	if(needed_item)
		to_chat(user, span_info("Now it's time to add \a [initial(needed_item.name)]."))
		user.visible_message(span_warning("[user] strikes the bar!"))
		return FALSE
	var/rank = user.rogue_skill_rank(recipe.appro_skill)
	var/intelligence = user.rogue_stat(ROGUE_STAT_INTELLIGENCE)
	var/chance
	if(!rank && !recipe.craftdiff)
		chance = 35
	else if(rank < recipe.craftdiff)
		chance = 10
	else
		chance = min(45 * rank, 100)
	hits++
	if(!prob(chance))
		user.rogue_craft_experience(recipe.appro_skill, intelligence / (recipe.craftdiff + 3))
		if(prob(chance))
			user.visible_message(span_warning("[user] fumbles the bar!"))
			return FALSE
		user.visible_message(span_warning("[user] ruins the bar!"))
		skill_quality -= 1
		bar_health -= recipe.craftdiff
		switch(rank)
			if(0)
				bar_health -= 25
			if(1 to 3)
				bar_health -= floor(20 / rank)
			if(4)
				bar_health -= 5
			if(5 to 6)
				if(user.rogue_badluck(4))
					bar_health -= recipe.craftdiff
		if(bar_health <= 0)
			user.visible_message(span_danger("[user] destroys the bar!"))
			qdel(parent)
		return FALSE
	var/moveup = ((from_blade && breakthrough) ? FORGING_BLADE_BREAKTHROUGH : 1) + round(rank * 6 * user.rogue_stat(ROGUE_STAT_STRENGTH) / 10 * (breakthrough ? 1.5 : 1)) - recipe.craftdiff
	progress = clamp(progress + moveup, 0, recipe.max_progress)
	skill_quality += rand(rank * 12, rank * 14) * moveup
	user.rogue_craft_experience(recipe.appro_skill, intelligence / (recipe.craftdiff + 1))
	if(breakthrough)
		user.visible_message(span_deadsay("[user] deftly strikes the bar!"))
		if(bar_health < 100)
			bar_health += 20
	else
		user.visible_message(span_info("[user] strikes the bar!"))
	if(progress < recipe.max_progress)
		return FALSE
	if(length(remaining))
		needed_item = pick_n_take(remaining)
		progress = 0
		to_chat(user, span_notice("\The [parent] needs \a [initial(needed_item.name)] to continue."))
		return FALSE
	stage = ROGUE_FORGING_COMPLETE
	// Ratwood complete_forging(): work begun from a cast blade is finished on the anvil, without a quench.
	if(from_blade)
		create_goods(get_turf(parent), user)
		return TRUE
	to_chat(user, span_notice("\The [parent] is ready to be quenched in a water bin."))
	return TRUE

/// Ratwood handle_creation(): hits per material, breakthroughs, the bars' quality and the smith's strikes make the tier.
/datum/component/rogue_forging/proc/create_goods(turf/where, mob/living/user)
	var/hits_per_material = ceil(hits / materials) - breakthroughs
	var/bar_tier = floor(material_quality / materials) - 4
	var/tier = floor((skill_quality / materials) / 1500) + bar_tier - floor(hits_per_material * 0.25)
	var/quality
	var/modifier
	switch(tier)
		if(-INFINITY to -2)
			quality = ROGUE_QUALITY_RUINED
			modifier = 0.3
		if(-1)
			quality = ROGUE_QUALITY_AWFUL
			modifier = 0.5
		if(0)
			quality = ROGUE_QUALITY_CRUDE
			modifier = 0.8
		if(1)
			quality = ROGUE_QUALITY_ROUGH
			modifier = 0.9
		if(2)
			quality = ROGUE_QUALITY_STANDARD
			modifier = 1
		if(3)
			quality = ROGUE_QUALITY_FINE
			modifier = 1.1
		if(4)
			quality = ROGUE_QUALITY_FLAWLESS
			modifier = 1.2
		else
			quality = ROGUE_QUALITY_MASTERWORK
			modifier = 1.3
	for(var/i in 1 to recipe.createditem_num)
		var/obj/item/made = new recipe.created_item(where)
		made.rogue_apply_forged_quality(quality, modifier)
		user?.log_message("forged [made.name] ([recipe.type]) (QUALITY: [tier]) (HITS: [hits_per_material])", LOG_GAME)
	qdel(parent)

/// The tier of forged goods: the name prefix, integrity cut below standard, and a masterwork comes out shining
/// (Ratwood handle_creation(): polished 4 and the metal glint).
/obj/item/proc/rogue_apply_forged_quality(quality, modifier)
	rogue_quality = quality
	var/prefix = rogue_quality_prefix(quality)
	if(prefix)
		name = "[prefix] [initial(name)]"
	if(modifier < 1 && uses_integrity)
		modify_max_integrity(max_integrity * modifier, FALSE)
	if(quality == ROGUE_QUALITY_MASTERWORK)
		rogue_shine()

#undef FORGING_HEALTH_PER_QUALITY
#undef FORGING_BLADE_BREAKTHROUGH
