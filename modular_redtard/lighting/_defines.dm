#define ROGUE_LIGHT_PACK_CHANNEL(value) (clamp(round((value) * ROGUE_LIGHT_STEPS), -ROGUE_LIGHT_PACK_BIAS, ROGUE_LIGHT_PACK_LIMIT) + ROGUE_LIGHT_PACK_BIAS)
#define ROGUE_LIGHT_PACK(corner) ((ROGUE_LIGHT_PACK_CHANNEL(corner.cache_r) << 16) | (ROGUE_LIGHT_PACK_CHANNEL(corner.cache_g) << 8) | ROGUE_LIGHT_PACK_CHANNEL(corner.cache_b))
#define ROGUE_LIGHT_MATRIX(r1, g1, b1, r2, g2, b2, r3, g3, b3, r4, g4, b4) list(r1, g1, b1, 0, r2, g2, b2, 0, r3, g3, b3, 0, r4, g4, b4, 0, 0, 0, 0, 1)
