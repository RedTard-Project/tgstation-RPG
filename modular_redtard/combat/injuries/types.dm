/// The injury type a blow of this kind and damage opens (Vibelin get_injury_type()): the first, worst first, whose
/// injury_pick_* the damage reaches; the last of the kind takes any damage. Null for a kind that has no injury.
/proc/rogue_injury_pick_list(kind, mechanical)
	if(!mechanical)
		switch(kind)
			if(ROGUE_INJURY_SLASH)
				return list(/datum/rogue_injury/slash/massive = "injury_pick_slash_massive", /datum/rogue_injury/slash/gaping_big = "injury_pick_slash_gaping_big", /datum/rogue_injury/slash/gaping = "injury_pick_slash_gaping", /datum/rogue_injury/slash/flesh = "injury_pick_slash_flesh", /datum/rogue_injury/slash/deep = "injury_pick_slash_deep", /datum/rogue_injury/slash/small = null)
			if(ROGUE_INJURY_PUNCTURE)
				return list(/datum/rogue_injury/puncture/massive = "injury_pick_puncture_massive", /datum/rogue_injury/puncture/gaping_big = "injury_pick_puncture_gaping_big", /datum/rogue_injury/puncture/gaping = "injury_pick_puncture_gaping", /datum/rogue_injury/puncture/flesh = "injury_pick_puncture_flesh", /datum/rogue_injury/puncture/small = null)
