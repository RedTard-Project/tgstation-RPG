		"mask64": "modular_redtard/icons/mob/onmob_mask_64.dmi"
	},
	"table": {
		"section": "port_vibelin_food.py",
		"note": "the numbers of the food and vessels of modular_redtard/items_vibelin/food.dm and vessels.dm (Vibelin's own, H2g), rewritten on every run of tools/port_vibelin_food.py; an override goes below the end line.",
		"out": ".cache/modular_redtard/agents/h2/staged/h2g/items.txt",
		"private": "config/redtard_private/mechanics/items.txt",
		"private_after": "# <<< port_vibelin_items.py"
	},
	"module_scan": "modular_redtard",
	"module_scan_skip": ["modular_redtard/items_vibelin"],
	"groups": {
		"food": {
			"file": "food.dm",
			"header": "Vibelin's own food (H2g): dishes, dough, produce and meat under the module's food (survival/: TG edible, grill and oven, Ratwood's bites, rot, slicing and recipes).",
			"rebase": [
				{"prefix": "/obj/item/reagent_containers/food/snacks", "to": "/obj/item/reagent_containers/food/snacks/vibelin"}
			],
			"abstract": ["/obj/item/reagent_containers/food/snacks"],
			"keep": ["possible_item_intents", "gripped_intents", "smeltresult", "lefthand_file", "righthand_file", "inhand_icon_state", "inhand_x_dimension", "inhand_y_dimension"]
		},
		"vessels": {
			"file": "vessels.dm",
			"header": "Vibelin's own vessels (H2g): bottles, cups, bowls, teapots, powders, pills and platters under the module's vessels (survival/vessels.dm, TG cups and plates).",
			"rebase": [
				{"prefix": "/obj/item/reagent_containers/glass/bottle", "to": "/obj/item/reagent_containers/glass/bottle/vibelin"},
				{"prefix": "/obj/item/reagent_containers/glass/cup", "to": "/obj/item/reagent_containers/glass/cup/vibelin"},
				{"prefix": "/obj/item/reagent_containers/glass/bowl", "to": "/obj/item/reagent_containers/glass/bowl/vibelin"},
				{"prefix": "/obj/item/reagent_containers/glass/carafe", "to": "/obj/item/reagent_containers/glass/carafe/vibelin"},
				{"prefix": "/obj/item/reagent_containers/powder", "to": "/obj/item/reagent_containers/powder/vibelin"},
				{"prefix": "/obj/item/reagent_containers/pill", "to": "/obj/item/reagent_containers/pill/vibelin"},
				{"prefix": "/obj/item/reagent_containers/lux", "to": "/obj/item/reagent_containers/lux/vibelin"},
				{"prefix": "/obj/item/reagent_containers/lux_tainted", "to": "/obj/item/reagent_containers/lux/vibelin_tainted"},
				{"prefix": "/obj/item/plate", "to": "/obj/item/plate/vibelin"}
			],
			"abstract": ["/obj/item/reagent_containers/powder"],
			"keep": ["possible_item_intents", "gripped_intents", "volume", "amount_per_transfer_from_this", "possible_transfer_amounts"],
			"resets": {"sellprice": "0", "list_reagents": "null"}
		}
	},
	"skip": [
		{"prefix": "/obj/item/reagent_containers/syringe", "reason": "a syringe: TG's syringe draws its own fill states (syringe_0 ...) over the sprite, Vibelin's sheet has none"},
		{"prefix": "/obj/item/grown/log", "reason": "not food: a log of Vibelin's bamboo, a crafting material of its carpentry"}
	],
	"path_aliases": {"/obj/item/plate": "/obj/item/cooking/platter"},
	"path_generic": ["rogue", "carved"],
	"icon_fallbacks": ["icons/roguetown/items/produce.dmi"],
