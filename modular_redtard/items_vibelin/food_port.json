	"path_note": "A Vibelin type is a duplicate when the module has a food or vessel of its name, at its path (after path_aliases, without the path_generic steps: Ratwood's rogue/breadslice/toast is Vibelin's breadslice/toast, carved/amber its amber), or of its last path step and its sprite. Vibelin renamed the stones of its carved cups, bowls and platters (petriamber, aoetal, joapstone ...); the path finds them.",
	"vessel_vars": ["volume", "amount_per_transfer_from_this", "possible_transfer_amounts", "spillable"],
	"plate_vars": ["max_items", "max_x_offset", "max_height_offset", "placement_offset"],
